#--------------------------------------------------------------------
# Example Environment Configuration file
#
# Copy this file to .env and configure the variables accordingly.
# For Railway deployment, set variables in the Railway Dashboard.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# Local development:
# app.baseURL = 'http://localhost:8080/'
#
# Railway (set in Dashboard → Variables):
# app.baseURL = 'https://your-app.railway.app/'
app.baseURL = 'http://localhost:8080/'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
# Local development:
# database.default.hostname = localhost
# database.default.database = laundry_db
# database.default.username = root
# database.default.password =
#
# Railway MySQL (auto-injected from MySQL service):
# database.default.hostname = $MYSQL_HOST
# database.default.database = $MYSQL_DATABASE
# database.default.username = $MYSQL_USER
# database.default.password = $MYSQL_PASSWORD
database.default.hostname = localhost
database.default.database = your_database_name
database.default.username = your_database_username
database.default.password = your_database_password
database.default.DBDriver = MySQLi

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# encryption.key =

#--------------------------------------------------------------------
# WHATSAPP NOTIFIKASI
#--------------------------------------------------------------------
# provider: link (manual wa.me) | fonnte | wablas
whatsapp.enabled = true
whatsapp.provider = link
whatsapp.apiToken = your_whatsapp_api_token_here
whatsapp.apiUrl = https://api.fonnte.com/send
whatsapp.businessName = "Your Laundry Name"

# Optional public customer API settings (no merchant secrets in the app).
# MOBILE_ALLOWED_ORIGINS = 'https://your-customer-web.example'
# outlet.nama = 'Sparkleen Laundry'
# outlet.noWa = ''
# outlet.alamat = ''
# outlet.jamBuka = '08:00'
# outlet.jamTutup = '21:00'

# Server-only webhook key; must differ from PAYMENT_API_KEY / client merchant keys.
# PAYMENT_API_URL = 'https://your-demo-gateway.example/api/transactions'
# PAYMENT_API_KEY = ''
# PAYMENT_WEBHOOK_SECRET = ''

# Customer payment UI is a simulator. Enable only on the intended test/staging backend.
# MOBILE_PAYMENTS_ENABLED = false
