{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "/usr/local/bin/start.sh",
    "healthcheckPath": "/login",
    "healthcheckTimeout": 60,
    "restartPolicyMaxRetries": 5
  }
}
